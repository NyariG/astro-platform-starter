---
import { kanonikusUrl } from '../utils/seo';

interface Props {
    cim: string;
    utvonal: string;
    felirat?: string;
    class?: string;
}

const { cim, utvonal, felirat = 'Megosztás', class: osztaly } = Astro.props;
const url = kanonikusUrl(utvonal);
const urlKod = encodeURIComponent(url);
const cimKod = encodeURIComponent(cim);

const csatornak = [
    {
        nev: 'Facebook',
        href: `https://www.facebook.com/sharer/sharer.php?u=${urlKod}`,
        ikon: 'M14 8.5h3V5h-3c-2.8 0-4.5 1.8-4.5 4.4V12H7v3.5h2.5V22H13v-6.5h3l.5-3.5H13V9.6c0-.7.4-1.1 1-1.1z'
    },
    {
        nev: 'LinkedIn',
        href: `https://www.linkedin.com/sharing/share-offsite/?url=${urlKod}`,
        ikon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z'
    },
    {
        nev: 'WhatsApp',
        href: `https://wa.me/?text=${cimKod}%20${urlKod}`,
        ikon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z'
    }
];
const gomb = 'inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-slate-300 bg-white text-slate-700 transition hover:border-primary hover:text-primary';
---

<div class:list={['megosztas flex flex-wrap items-center gap-x-3 gap-y-2', osztaly]} data-megosztas-cim={cim} data-megosztas-url={url}>
    <span class="text-xs font-semibold tracking-wider text-slate-500 uppercase">{felirat}</span>
    <ul class="flex flex-wrap items-center gap-2">
        <li data-nativ hidden>
            <button type="button" class={gomb} data-nativ-gomb aria-label="Megosztás másik alkalmazásban" title="Megosztás másik alkalmazásban">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path></svg>
            </button>
        </li>
        {
            csatornak.map((csatorna) => (
                <li>
                    <a href={csatorna.href} target="_blank" rel="noopener noreferrer nofollow" class={gomb} aria-label={`Megosztás: ${csatorna.nev}`} title={`Megosztás: ${csatorna.nev}`}>
                        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d={csatorna.ikon}></path></svg>
                    </a>
                </li>
            ))
        }
        <li>
            <a href={`mailto:?subject=${cimKod}&body=${cimKod}%0A%0A${urlKod}`} class={gomb} aria-label="Küldés e-mailben" title="Küldés e-mailben">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="M3.5 6.5L12 13l8.5-6.5"></path></svg>
            </a>
        </li>
        <li>
            <button type="button" class={gomb} data-link-masolas aria-label="Link másolása" title="Link másolása">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 006.4 0l3-3a4.5 4.5 0 00-6.4-6.4l-1 1"></path><path d="M14 10a4.5 4.5 0 00-6.4 0l-3 3a4.5 4.5 0 006.4 6.4l1-1"></path></svg>
            </button>
        </li>
    </ul>
    <span role="status" class="text-sm font-medium text-primary" data-megosztas-allapot></span>
</div>

<script>
    document.querySelectorAll<HTMLElement>('.megosztas').forEach((blokk) => {
        const cim = blokk.dataset.megosztasCim ?? document.title;
        const url = blokk.dataset.megosztasUrl ?? location.href;
        const allapot = blokk.querySelector<HTMLElement>('[data-megosztas-allapot]');
        const nativ = blokk.querySelector<HTMLElement>('[data-nativ]');
        let idozito: number | undefined;

        function jelez(szoveg: string) {
            if (!allapot) return;
            allapot.textContent = szoveg;
            clearTimeout(idozito);
            idozito = window.setTimeout(() => (allapot.textContent = ''), 3000);
        }

        if (nativ && typeof navigator.share === 'function' && matchMedia('(pointer: coarse)').matches) {
            nativ.hidden = false;
            nativ.querySelector('[data-nativ-gomb]')?.addEventListener('click', () => {
                navigator.share({ title: cim, url }).catch(() => undefined);
            });
        }

        blokk.querySelector('[data-link-masolas]')?.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(url);
                jelez('Link másolva');
            } catch {
                jelez('A másolás nem sikerült');
            }
        });
    });
</script>
