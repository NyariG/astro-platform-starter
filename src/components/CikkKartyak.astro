---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { KATEGORIAK, datumSzoveg } from '../data/blog';

interface Props {
    cikkek: CollectionEntry<'blog'>[];
    cimSzint?: 'h2' | 'h3';
}

const { cikkek, cimSzint = 'h2' } = Astro.props;
const Cim = cimSzint;
---

<ul class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
        cikkek.map((cikk) => (
            <li>
                <a href={`/blog/${cikk.id}/`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
                    <div class="flex aspect-[16/10] items-center justify-center bg-slate-50 p-4">
                        {cikk.data.kep &&
                            (cikk.data.kep.format === 'svg' ? (
                                <img src={cikk.data.kep.src} alt="" width={cikk.data.kep.width} height={cikk.data.kep.height} loading="lazy" class="max-h-full w-auto" />
                            ) : (
                                <Image src={cikk.data.kep} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 360px, 100vw" class="max-h-full w-auto rounded-md shadow" />
                            ))}
                    </div>
                    <div class="flex flex-1 flex-col p-6">
                        <p class="text-xs font-semibold tracking-wider text-primary uppercase">{KATEGORIAK[cikk.data.kategoria].nev}</p>
                        <Cim class="mt-2 text-xl leading-snug font-bold text-slate-900 group-hover:text-primary">{cikk.data.cim}</Cim>
                        <p class="mt-3 flex-1 text-slate-600">{cikk.data.leiras}</p>
                        <p class="mt-5 text-sm text-slate-500">
                            <time datetime={cikk.data.megjelent.toISOString()}>{datumSzoveg(cikk.data.megjelent)}</time>
                        </p>
                    </div>
                </a>
            </li>
        ))
    }
</ul>
