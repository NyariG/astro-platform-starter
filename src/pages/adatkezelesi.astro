                        v: 'Az érintett jogainak megsértése esetén bírósághoz fordulhat. A pert – az érintett választása szerint – a lakóhelye vagy tartózkodási helye szerinti törvényszéken is megindíthatja.'
                    }
                ]
            }
        ]
    },
    {
        id: 'jogszabalyok',
        szam: 13,
        cim: 'Az adatkezelés alapjául szolgáló jogszabályok',
        alszakaszok: [
            {
                cim: 'GDPR (2016/679 EU rendelet)',
                blokkok: [
                    {
                        t: 'p',
                        v: 'Az Európai Parlament és a Tanács (EU) 2016/679 rendelete, amelynek célja a természetes személyek védelme a személyes adatok kezelése során, és az adatok szabad áramlásának biztosítása az EU-n belül.'
                    }
                ]
            },
            {
                cim: '2011. évi CXII. törvény az információs önrendelkezési jogról',
                blokkok: [
                    {
                        t: 'p',
                        v: 'A magyar adatvédelmi törvény, amely a személyes adatok kezelésének hazai alapelveit és korlátait szabályozza.'
                    }
                ]
            },
            {
                cim: 'Egyéb releváns magyar jogszabályok',
                blokkok: [
                    {
                        t: 'ul',
                        v: [
                            '2000. évi C. törvény a számvitelről.',
                            '2013. évi V. törvény a Polgári Törvénykönyvről (Ptk.).',
                            '2008. évi XLVIII. törvény a gazdasági reklámtevékenység alapvető feltételeiről.'
                        ]
                    }
                ]
            }
        ]
    },
    {
        id: 'zaro',
        szam: 14,
        cim: 'Záró rendelkezések',
        alszakaszok: [
            {
                cim: 'A tájékoztató hatálya és módosításának lehetőségei',
                blokkok: [
                    { t: 'p', v: 'Jelen Tájékoztató 2026.07.01 napjától hatályos.' },
                    {
                        t: 'p',
                        v: 'Az Adatkezelő jogosult a Tájékoztató egyoldalú módosítására, különösen a jogszabályi változások, új adatkezelési tevékenységek bevezetése vagy a felügyeleti hatóság ajánlásainak figyelembevétele érdekében.'
                    },
                    {
                        t: 'p',
                        v: 'A módosításokat a weboldalon közzétesszük, és a hatálybalépést követően az érintettek elfogadják az új szabályokat a szolgáltatások további használatával.'
                    },
                    { t: 'p', v: 'Kelt: Abda, 2026.07.01. — Nyári Gergő Mátyás e.v.' }
                ]
            }
        ]
    }
];
---

<Layout
    title="Adatvédelmi és Adatkezelési Szabályzat – Nyári Terv"
    description="A Nyári Terv adatvédelmi és adatkezelési tájékoztatója a GDPR és a 2011. évi CXII. törvény szerint."
>

    <section class="bg-slate-50 border-b border-slate-200">
        <div class="container-custom py-12 sm:py-16">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary">Adatvédelem</p>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Adatvédelmi és Adatkezelési Szabályzat</h1>
            <p class="mt-4 max-w-2xl text-lg text-slate-600">
                Ez a tájékoztató bemutatja, hogyan kezeljük az Ön személyes adatait, és milyen jogok illetik meg Önt a GDPR és a magyar adatvédelmi jog
                szerint.
            </p>
            <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-4 py-1.5 text-sm font-medium text-slate-700">
                <svg class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008z" />
                </svg>
                Hatályos: {HATALYOS}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-custom">
            <div class="lg:grid lg:grid-cols-[16rem_1fr] lg:gap-12">

                <aside class="mb-8 lg:mb-0">

                    <details class="rounded-lg border border-slate-200 bg-white lg:hidden">
                        <summary class="cursor-pointer list-none px-4 py-3 font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
                            <span class="flex items-center justify-between">
                                Tartalomjegyzék
                                <svg class="h-5 w-5 text-slate-400 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                </svg>
                            </span>
                        </summary>
                        <nav class="border-t border-slate-200 px-2 py-2">
                            <ol class="flex flex-col">
                                {
                                    szakaszok.map((sz) => (
                                        <li>
                                            <a href={`#${sz.id}`} class="block rounded-md px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 hover:text-primary">
                                                {sz.szam}. {sz.cim}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ol>
                        </nav>
                    </details>

                    <nav class="sticky top-24 hidden max-h-[calc(100vh-8rem)] overflow-y-auto lg:block" aria-label="Tartalomjegyzék">
                        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Tartalomjegyzék</p>
                        <ol class="flex flex-col gap-0.5 border-l border-slate-200">
                            {
                                szakaszok.map((sz) => (
                                    <li>
                                        <a
                                            href={`#${sz.id}`}
                                            class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm text-slate-600 transition hover:border-primary hover:text-primary"
                                        >
                                            <span class="text-slate-400">{sz.szam}.</span> {sz.cim}
                                        </a>
                                    </li>
                                ))
                            }
                        </ol>
                    </nav>
                </aside>

                <div class="min-w-0 max-w-3xl">
                    <div class="flex flex-col gap-12">
                        {
                            szakaszok.map((sz) => (
                                <section id={sz.id} class="scroll-mt-24">
                                    <h2 class="group flex items-baseline gap-3 text-2xl font-bold tracking-tight text-slate-900">
                                        <span class="text-lg font-semibold text-primary">{sz.szam}.</span>
                                        <span>{sz.cim}</span>
                                    </h2>
                                    <div class="mt-6 flex flex-col gap-8">
                                        {sz.alszakaszok.map((asz) => (
                                            <div>
                                                <h3 class="text-lg font-semibold text-slate-800">{asz.cim}</h3>
                                                <div class="mt-3 flex flex-col gap-4">
                                                    {asz.blokkok.map((b) =>
                                                        b.t === 'p' ? (
                                                            <p class="leading-relaxed text-slate-600">{b.v}</p>
                                                        ) : b.t === 'ul' ? (
                                                            <ul class="flex list-disc flex-col gap-2 pl-5 text-slate-600 marker:text-primary">
                                                                {b.v.map((item) => (
                                                                    <li class="leading-relaxed">{item}</li>
                                                                ))}
                                                            </ul>
                                                        ) : b.t === 'dl' ? (
                                                            <dl class="flex flex-col gap-3">
                                                                {b.v.map(([term, def]) => (
                                                                    <div>
                                                                        <dt class="font-semibold text-slate-800">{term}</dt>
                                                                        <dd class="leading-relaxed text-slate-600">{def}</dd>
                                                                    </div>
                                                                ))}
                                                            </dl>
                                                        ) : (
                                                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                                                                {b.cim && <p class="border-b border-slate-200 bg-white px-5 py-3 font-semibold text-slate-900">{b.cim}</p>}
                                                                <dl class="divide-y divide-slate-200">
                                                                    {b.v.map(([k, val]) => (
                                                                        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                                                                            <dt class="text-sm text-slate-500">{k}</dt>
                                                                            <dd class="font-medium text-slate-900">{val}</dd>
                                                                        </div>
                                                                    ))}
                                                                </dl>
                                                            </div>
                                                        )
                                                    )}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </section>
                            ))
                        }
                    </div>

                    <div class="mt-16 border-t border-slate-200 pt-8">
                        <a href="#top" class="text-sm font-semibold text-primary hover:text-primary/80">↑ Vissza a lap tetejére</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
