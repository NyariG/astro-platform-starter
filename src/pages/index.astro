---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import { Image } from 'astro:assets';
import heroBg from '../assets/hatterkep_jo.png';
import planningImg from '../assets/planning.jpg';
import { getCollection } from 'astro:content';
import CikkKartyak from '../components/CikkKartyak.astro';
import WekerleSav from '../components/WekerleSav.astro';
import { szervezetSema, webhelySema } from '../utils/seo';

const legujabbCikkek = (await getCollection('blog', ({ data }) => !data.vazlat)).sort((a, b) => b.data.megjelent.getTime() - a.data.megjelent.getTime()).slice(0, 3);

const services = [
    {
        title: "Családi Házak",
        description: "Teljes körű gépészeti tervezés új építésű és felújítandó családi házakhoz. A ház adottságaihoz, a nyílászárókhoz és a szigeteléshez igazítva, akár a meglévő gázkazán megtartásával, hibrid rendszerben.",
        iconPath: "M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
        features: ["Fűtés és hűtés", "Szellőztető rendszerek", "Víz- és csatornahálózat", "Hőszivattyús rendszerek"]
    },
    {
        title: "Társasházak",
        description: "Többlakásos épületek komplex gépészeti tervezése. Lakásonkénti hőmennyiségmérés, hidraulikai beszabályozás, valamint központi kazánház vagy hőszivattyús kaszkád méretezése és tervezése.",
        iconPath: "M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5M12 6.75h1.5M15 6.75h1.5M9 10.5h1.5M12 10.5h1.5M15 10.5h1.5M9 14.25h1.5M12 14.25h1.5M15 14.25h1.5M9 18h1.5M12 18h1.5M15 18h1.5",
        features: ["Központi gépészet", "Egyedi mérési megoldások", "Tűzvédelmi rendszerek", "Szennyvíz elvezetés"]
    },
    {
        title: "Energetikai Tanúsítvány",
        description: "Hiteles energetikai tanúsítványok készítése gyors határidővel, rejtett költségek nélkül. Hivatalos dokumentum adásvételhez és pályázathoz.",
        iconPath: "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
        features: ["Akár 24 órán belül", "Hivatalos jogosultság", "Helyszíni felmérés", "Teljes körű ügyintézés"],
        link: "/energetikai-tanusitvany/"
    },
    {
        title: "Tervezés és Kivitelezés",
        description: "Új építésű és felújítási munkákat is vállalok: először elkészítem a gépészeti terveket, majd ezek alapján a kivitelezést is elvégzem, teljes körű garanciával.",
        iconPath: "M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z",
        features: ["Új építésű ingatlanok", "Felújítási munkálatok", "Mérnöki tervek alapján", "Teljes körű garancia"]
    }
];

const systems = [
    "Fűtés", "Hűtés", "Szellőzés", "Vízellátás", "Szennyvíz", "Esővíz elvezetés"
];
---

<Layout
    title="Nyári Terv – Precíz épületgépészeti tervezés"
    description="Fűtés, hűtés, szellőzés, víz- és szennyvízrendszerek tervezése családi házakhoz és társasházakhoz, valamint energetikai tanúsítvány Győrben és környékén."
    semak={[szervezetSema(), webhelySema()]}
>
    <!-- Hero Section -->
    <section class="relative bg-slate-50 overflow-hidden">
        <div class="absolute inset-0">
            <Image src={heroBg} alt="Épületgépészeti tervek" loading="eager" fetchpriority="high" class="w-full h-full object-cover opacity-20" />
        </div>
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#2563eb_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="container-custom relative z-10 py-24 sm:py-32 lg:pb-40">
            <div class="mx-auto max-w-2xl text-center">
                <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl mb-6">
                    Nyári Terv <span class="block text-primary text-2xl sm:text-4xl mt-2 font-medium">Precíz épületgépészeti tervezés</span>
                </h1>
                <p class="mt-6 text-lg leading-8 text-slate-600">
                    Fűtés, hűtés, szellőzés, víz, szennyvíz és esővíz rendszerek tervezése és <strong>kivitelezése</strong>, valamint hiteles energetikai tanúsítványok készítése.
                </p>
                <div class="mt-10 flex items-center justify-center gap-x-6">
                    <a href="/ajanlat" class="btn text-base px-8 py-3">
                        Ajánlatkérés
                    </a>
                    <a href="#szolgaltatasok" class="text-sm font-semibold leading-6 text-slate-900 hover:text-primary transition">
                        Szolgáltatások megtekintése <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="szolgaltatasok" class="section bg-white">
        <div class="container-custom">
            <div class="mx-auto max-w-2xl text-center mb-16">
                <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Szolgáltatások</h2>
                <p class="mt-4 text-lg text-slate-600">
                    Magánszemélyeknek és beruházóknak készítek engedélyezési és kivitelezési gépészeti terveket, hőtechnikai számításokkal és tételes költségvetési kiírással. Ezekből a kivitelező félreértések és pótmunkák nélkül tud dolgozni.
                </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8">
                {services.map((service) => (
                    <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 hover:shadow-lg transition-shadow duration-300 flex flex-col h-full">
                        <div class="text-primary mb-6">
                            <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d={service.iconPath} />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-900 mb-4">{service.title}</h3>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            {service.description}
                        </p>
                        <ul class="space-y-3 mb-6 flex-grow">
                            {service.features.map((feature) => (
                                <li class="flex items-center text-slate-700">
                                    <svg class="h-5 w-5 text-primary mr-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                    </svg>
                                    {feature}
                                </li>
                            ))}
                        </ul>
                        {service.link && (
                            <a href={service.link} class="btn w-full mt-auto">Részletek</a>
                        )}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Detailed Systems Section -->
    <section class="section bg-slate-900 text-white">
        <div class="container-custom">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6 text-white">
                        Korszerű Rendszerek Tervezése
                    </h2>
                    <p class="text-slate-300 text-lg mb-8 leading-relaxed">
                        Hőveszteség-számítással kezdek, erre épül a padló- és falfűtési körök kiosztása és a <strong>hőszivattyú kiválasztása</strong>. Az alulméretezett gép a leghidegebb napokon elektromos fűtőpatronnal pótolja a hiányt, és ez drága. A túlméretezett gép sűrűn ki-be kapcsol, és hamarabb elhasználódik. A pontos méretezés mindkettőt megelőzi.
                    </p>
                    <div class="grid grid-cols-2 gap-4">
                        {systems.map((system) => (
                            <div class="flex items-center gap-3 p-3 bg-slate-800 rounded-lg">
                                <div class="h-2 w-2 rounded-full bg-primary"></div>
                                <span class="font-medium">{system}</span>
                            </div>
                        ))}
                    </div>
                </div>
                <div class="relative h-64 lg:h-96 rounded-2xl overflow-hidden bg-slate-800 flex items-center justify-center border border-slate-700">
                    <Image src={planningImg} alt="Tervezés folyamatban" class="w-full h-full object-cover" />
                </div>
            </div>
        </div>
    </section>

    <WekerleSav />

    {
        legujabbCikkek.length > 0 && (
            <section class="section bg-white">
                <div class="container-custom">
                    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <h2>Friss cikkek a blogon</h2>
                            <p class="mt-3 text-lg text-slate-600">Gyakorlati válaszok építkezés, felújítás és ingatlaneladás előtt.</p>
                        </div>
                        <a href="/blog/" class="font-semibold">Összes cikk →</a>
                    </div>
                    <CikkKartyak cikkek={legujabbCikkek} cimSzint="h3" />
                </div>
            </section>
        )
    }

    <!-- Contact Section -->
    <Contact />
</Layout>
