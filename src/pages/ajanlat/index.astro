---
import Layout from '../../layouts/Layout.astro';
import QuoteForm from './_components/QuoteForm.tsx';
---

<Layout
    title="Azonnali Árajánlatkérés – Nyári Terv"
    description="Kérjen azonnali árajánlatot épületgépészeti tervezésre PDF-ben, mindössze 2 perc alatt."
    minimal
>
    <section class="section bg-slate-50 py-6 sm:py-8">
        <div class="container-custom">
            <div class="mx-auto max-w-2xl text-center">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                    Azonnali épületgépészeti árajánlat PDF-ben 2 perc alatt!
                </h1>
                <p class="mt-2 text-base text-slate-600 sm:text-lg">
                    Válaszoljon pár egyszerű kérdésre az ingatlanról, és a rendszerünk azonnal kiállítja a személyre szabott ajánlatot.
                </p>
            </div>
        </div>
    </section>

    <section class="section pt-2 sm:pt-4">
        <div class="container-custom">
            <div class="mx-auto max-w-6xl">
                <QuoteForm client:load />
            </div>
        </div>
    </section>

    <script is:inline>
        window.ntTrack && window.ntTrack('ViewContent', { content_name: 'arajanlatkero', content_category: 'arajanlat' });
    </script>
</Layout>
