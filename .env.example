# Árajánlatkérő modul — környezeti változók
#
# Élesben ezeket a Netlify felületén kell beállítani
# (Site configuration → Environment variables).
# Lokális fejlesztéshez másold ezt a fájlt `.env` néven, és töltsd ki.
#
# FIGYELEM: egyik változó sem kaphat PUBLIC_ prefixet — az beépülne a
# kliensoldali bundle-be, és a böngészőből olvashatóvá tenné az API kulcsot.

# SMTP2GO API kulcs a levélküldéshez (üzemeltetői értesítő). Titkos.
SMTP2GO_API_KEY=

# ── Gmail SMTP — az ügyfél árajánlat-levele ───────────────────────
# A feladó/SMTP-felhasználó Gmail (vagy Google Workspace) cím.
GMAIL_SENDER=ajanlat@nyariterv.hu
# Google alkalmazásjelszó (szóközök nélkül). TITKOS — csak .env / Netlify secret,
# a kódba soha. A fiókon 2FA + generált app-jelszó szükséges.
GMAIL_APP_PASSWORD=

# ── DOCX → PDF konverzió ──────────────────────────────────────────
# A konverzió-választó. Alapértelmezett: auto.
#   auto                      → Python → CloudConvert → beépített (mindig ad PDF-et, ajánlott)
#   python                    → csak a saját Python szolgáltatás (1 retryvel)
#   cloudconvert              → csak a CloudConvert
#   builtin                   → csak a beépített pdf-lib generátor (függelékmentes, Netlify-n is fut)
#   python-then-cloudconvert  → Python, hiba/timeout esetén CloudConvert
#   off                       → nincs PDF (a levél PDF nélkül megy ki)
PDF_CONVERTER=auto

# A saját Python + LibreOffice konverziós szolgáltatás (Render) alap-URL-je.
# Üresen hagyva a Python út kimarad, és a CloudConvert veszi át (ha van kulcs).
PDF_CONVERTER_URL=

# Megosztott titok a Node ↔ Python hitelesítéshez (Bearer). Titkos.
# UGYANEZ az érték kerüljön a Render CONVERTER_TOKEN env-jébe.
PDF_CONVERTER_TOKEN=

# A sablon-feltöltő (seed) végpont védelme élesben. Titkos.
# Beállítva: POST /api/ajanlat-sablon-seed csak `Authorization: Bearer <token>`-nel.
# Üresen hagyva a seed végpont élesben 404 (csak fejlesztői módban érhető el).
SABLON_SEED_TOKEN=

# CloudConvert API kulcs a DOCX→PDF konverzióhoz (fallback / önálló mód). Titkos.
# Kulcs nélkül a beküldés működik, csak PDF nélkül (a levél a többi tartalommal kimegy).
# A kulcsnak jogosultságot kell adni a `task.read`, `task.write` scope-okra.
CLOUDCONVERT_API_KEY=

# A kimenő levelek feladója. A domainnek hitelesítettnek kell lennie
# az SMTP2GO-ban (SPF + DKIM), különben a levelek spam mappába kerülnek.
QUOTE_SENDER_EMAIL=ajanlat@nyariterv.hu

# Erre a címre érkeznek az ügyfelek válaszai.
QUOTE_REPLY_TO=info@nyariterv.hu

# Ide megy az üzemeltetői értesítés. Több cím vesszővel elválasztva.
QUOTE_NOTIFY_EMAIL=info@nyariterv.hu,ajanlat@nyariterv.hu

# Debug mód: ha be van állítva, MINDKÉT levél (admin + ügyfél) erre a címre is
# elmegy rejtett másolatként (bcc), teszteléshez. Több cím vesszővel. Élesben ÜRES.
DEBUG_EMAIL_TO=

# Opcionális: napi kérésszám egy IP-címről. Beállítás nélkül 10.
# Ez csak másodlagos spam-fék; a valódi korlát az e-mail címre vonatkozó napi 1 ajánlat.
QUOTE_IP_LIMIT=10

# ── Telegram admin-bot (Iteráció 1) ───────────────────────────────
# A @BotFather-tól kapott bot token. Titkos. Enélkül a bot néma (a beküldés így is működik).
TELEGRAM_BOT_TOKEN=
# A bot felhasználóneve @ nélkül (deep-link összekötéshez: t.me/<username>?start=<token>).
TELEGRAM_BOT_USERNAME=
# Kitalált, kiszámíthatatlan útvonal-szegmens a webhookhoz: /api/telegram/<ez>. Titkos.
TELEGRAM_WEBHOOK_PATH=
# A setWebhook secret_token — a Telegram ezt küldi az X-Telegram-Bot-Api-Secret-Token
# fejlécben minden híváskor; a végpont enélkül 403. Titkos, hosszú véletlen érték.
TELEGRAM_WEBHOOK_SECRET=
